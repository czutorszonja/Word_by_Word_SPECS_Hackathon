  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WbwHudUI – Menu (demo) stand-in button</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float followDistanceCm = 60 {"hint":"Distance in front of the user (cm)", "widget":"slider", "min":40, "max":100, "step":1}'
    - '// @input float offsetRightCm = -4 {"hint":"Sideways offset from the view centre (cm, negative = left)", "widget":"slider", "min":-30, "max":30, "step":0.5}'
    - '// @input float offsetUpCm = -17 {"hint":"Vertical offset from eye level (cm, negative = low)", "widget":"slider", "min":-35, "max":10, "step":0.5}'
    - '// @input float chipOffsetRightCm = -15 {"hint":"Use it live: the HUD collapses to a small Menu chip. Sideways offset of the chip (cm, negative = left edge of view)", "widget":"slider", "min":-30, "max":30, "step":0.5}'
    - '// @input float chipOffsetUpCm = 9 {"hint":"Use it live: vertical offset of the Menu chip (cm, negative = low). Low-left keeps it clear of the server, the caption and the phrase cards", "widget":"slider", "min":-35, "max":10, "step":0.5}'
    - '// @input float chipWidthCm = 7.4 {"hint":"Width of the Menu button on the compact chip (cm); the chip is at least this wide, and wider when the mode name above the button needs it", "widget":"slider", "min":5, "max":12, "step":0.1}'
    - '// @input float chipHeightCm = 3.9 {"hint":"Height of the Menu button on the compact chip (cm); keep at least 3.8 cm so it stays easy to pinch. The mode name sits above it", "widget":"slider", "min":3.8, "max":6, "step":0.1}'
    - '// @input float followSpeed = 5 {"hint":"How quickly the HUD catches up with head movement (higher = snappier)", "widget":"slider", "min":1, "max":15, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
