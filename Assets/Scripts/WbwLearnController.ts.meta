  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WbwLearnController – brackets, word card, save</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
