    - '// @input float viewHalfHeightDeg = 19 {"hint":"Half height of the Specs view (deg)", "widget":"slider", "min":10, "max":30, "step":0.5}'
    - '// @input float hudClearDeg = 11.5 {"hint":"The word card stays above this angle below the gaze (deg) so it never covers the HUD strip", "widget":"slider", "min":5, "max":19, "step":0.5}'
