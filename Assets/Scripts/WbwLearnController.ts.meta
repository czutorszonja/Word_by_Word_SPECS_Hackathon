    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float maxBrackets = 4 {"hint":"How many learnable objects are bracketed at once (brief: 3–4)", "widget":"slider", "min":1, "max":6, "step":1}'
