  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WbwMain – Word by Word café (setup, menu, modes)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 setupPanel {"hint":"Language setup panel"}'
    - "// @input AssignableType_2 toast {\"hint\":\"'Café detected (demo)' toast\"}"
    - '// @input AssignableType_3 hud {"hint":"HUD with the ✋ Menu stand-in button"}'
    - '// @input AssignableType_4 modeMenu {"hint":"Mode menu"}'
    - '// @input AssignableType_5 cafe {"hint":"Café builder (virtual café stand-in)"}'
    - '// @input AssignableType_6 learn {"hint":"Learn mode controller"}'
    - '// @input AssignableType_7 order {"hint":"Use it live controller"}'
    - '// @input AssignableType_8 practice {"hint":"Practice controller"}'
    - '// @input AssignableType_9 audio {"hint":"Audio controller"}'
    - '// @input AssignableType_10 suggestion {"hint":"Arrival suggestion panel (Learn / Practice / Use it live / Later). Empty = created at start"}'
    - "// @input AssignableType_11 wordList {\"hint\":\"Saved-words viewer (opened from the menu's Words saved). Empty = created at start\"}"
    - "// @input AssignableType_12 languages {\"hint\":\"Language settings (opened from the menu's Languages). Empty = created at start\"}"
    - "// @input Asset.AudioTrackAsset micAudio {\"hint\":\"Microphone Audio asset (Asset Browser → + → Microphone Audio) for 'say it out loud' in Use it live. Empty = only the Said it button ends a speak turn\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string toastText = "Café detected (demo)" {"hint":"Stand-in for location recognition, shown after setup"}'
    - '// @input float toastSeconds = 3 {"hint":"Seconds the toast stays (brief: about 3 s)", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input string firstMode = "learn" {"hint":"Mode entered by itself after the toast. Used only when the arrival suggestion is off or setup is skipped", "widget":"combobox", "values":[{"label":"Learn", "value":"learn"}, {"label":"Use it live", "value":"live"}, {"label":"Practice", "value":"practice"}, {"label":"None (menu only)", "value":"none"}]}'
    - '// @input float setupDistanceCm = 70 {"hint":"Distance of the setup panel in front of the user (cm) — brief: ~70 cm", "widget":"slider", "min":40, "max":110, "step":1}'
    - '// @input bool raiseHandOpensMenu = true {"hint":"On Specs: raising an open hand (palm toward you) opens the mode menu next to it. The HUD Menu button is the preview stand-in."}'
    - '// @input bool skipSetup {"hint":"Skip the setup panel, the walk-in and the suggestion (handy while iterating): toast, then the first mode"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Arrival"}'
    - '// @input bool arrivalSuggestion = true {"hint":"After the toast, offer Learn / Practice / Use it live / Later and wait for a pick: no mode starts by itself and the HUD stays hidden until then. Off = the first mode (Settings) starts by itself after the toast"}'
    - '// @input float toastAfterWalkCm = 80 {"hint":"The toast appears once the learner has walked this far after Start (cm)...", "widget":"slider", "min":0, "max":300, "step":5}'
    - '// @input float toastFallbackSec = 1.5 {"hint":"...or this many seconds after Start, whichever comes first", "widget":"slider", "min":0, "max":6, "step":0.1}'
    - '// @input float suggestAutoPickSec {"hint":"Kiosk only: seconds on the suggestion panel after which the suggested option is picked by itself. 0 = never (nothing starts by itself)", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @ui {"widget":"group_end"}'
