    - '// @input float maxLabelDistanceCm = 250 {"hint":"The label is never placed farther than this (cm): far things outside (a fountain behind trees) would otherwise have their label hidden by nearer objects. It is sized for its distance, so it looks the same", "widget":"slider", "min":120, "max":600, "step":10}'
