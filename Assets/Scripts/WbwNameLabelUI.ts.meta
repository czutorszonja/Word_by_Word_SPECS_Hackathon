    - '// @input float replaceTurnDeg = 8 {"hint":"Re-place the label when the head turned this far since it was placed (deg)", "widget":"slider", "min":2, "max":30, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - "// @input float labelBoost = 1.25 {\"hint\":\"Text size factor for the label's real distance. Word cards use READ_BOOST 2.0; a smaller value keeps the label small (about a 2.2 cm Hungarian line at ~110 cm)\", \"widget\":\"slider\", \"min\":0.8, \"max\":2, \"step\":0.05}"
    - '// @input bool drawBracket = true {"hint":"Draw the discreet focus bracket around the pointed-at object"}'
    - '// @input bool drawConnector = true {"hint":"Draw the short connector line from the object to the label"}'
    - '// @input bool drawPointerDot = true {"hint":"Preview and LEAF only: draw the small dot where the pointer meets the pointed-at object (on Specs SIK draws its own cursor)"}'
    - '// @ui {"widget":"group_end"}'
