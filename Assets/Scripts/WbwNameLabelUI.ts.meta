  InputLines:
    - '// @ui {"widget":"label", "label":"WbwNameLabelUI – hover label beside the pointed-at object"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Placement"}'
    - '// @input float viewHalfWidthDeg = 16 {"hint":"Half width of the Specs view (deg): the label stays inside it", "widget":"slider", "min":10, "max":30, "step":0.5}'
