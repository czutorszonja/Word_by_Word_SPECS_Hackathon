  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WbwOrderController – Use it live (scripted order + tables)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 caption {"hint":"Server caption bubble UI"}'
    - '// @input AssignableType_2 phrases {"hint":"Phrase cards UI"}'
    - '// @input AssignableType_3 hint {"hint":"Hint line + edge arrow UI"}'
    - '// @input AssignableType_4 server {"hint":"The scripted server character"}'
    - '// @input SceneObject seating {"hint":"Seating root: children Table_<n>, each with a TableCard_<n> child"}'
    - '// @input SceneObject phraseTray {"hint":"Authored tray on the sandwich counter where the phrase cards lie (tilted toward the user)"}'
    - '// @input AssignableType_5 phraseHelper {"hint":"Phrase helper view (SAY IT AT THE COUNTER). Empty = WbwMain creates one at start"}'
    - '// @input AssignableType_6 speakPrompt {"hint":"Say-it strip with the Said it button. Empty = WbwMain creates one at start"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input float replyPauseSec = 0.6 {\"hint\":\"Pause between the user's answer and the server's next line (s)\", \"widget\":\"slider\", \"min\":0, \"max\":3, \"step\":0.1}"
    - "// @input float captionLingerSec = 4 {\"hint\":\"Seconds the caption stays after the server's line ends\", \"widget\":\"slider\", \"min\":0, \"max\":10, \"step\":0.5}"
    - '// @input bool phrasesOnCounter = true {"hint":"Lay the phrase cards on the counter tray (user looks down to pick). Off = float in front of the user."}'
    - '// @input float maxTrayDistanceCm = 260 {"hint":"Cards lie on the counter tray only while the user is within this distance of it (cm); further away they float in front of the user", "widget":"slider", "min":100, "max":500, "step":10}'
    - '// @input float phraseDistanceCm = 68 {"hint":"Distance of the phrase cards in front of the user when NOT on the counter (cm)", "widget":"slider", "min":40, "max":90, "step":1}'
    - '// @input float phraseDropCm = 7 {"hint":"How far below eye level the phrase cards sit (cm)", "widget":"slider", "min":0, "max":40, "step":1}'
    - '// @input float serverNoticeCm = 260 {"hint":"The server starts talking once the learner is this close to him (cm)...", "widget":"slider", "min":100, "max":400, "step":10}'
    - '// @input float serverNoticeDeg = 30 {"hint":"...faces him within this angle (deg)...", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float serverNoticeSec = 1.2 {"hint":"...for this long (s)", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - '// @input bool serverNotices = true {"hint":"The server notices the learner by himself (near + facing). Off = the order starts only from code (tests)"}'
    - "// @input float tableLookDeg = 8 {\"hint\":\"A table's number is read when the learner looks within this angle of it (deg)...\", \"widget\":\"slider\", \"min\":2, \"max\":20, \"step\":0.5}"
    - '// @input float tableLookSec = 0.5 {"hint":"...for this long (s)", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float tableLookCm = 520 {"hint":"Farthest a table number can be read by looking (cm)", "widget":"slider", "min":100, "max":800, "step":10}'
    - "// @input float arrowInViewDeg = 24 {\"hint\":\"Objects within this angle (deg) of the view direction count as 'in view' for the arrow\", \"widget\":\"slider\", \"min\":10, \"max\":45, \"step\":1}"
    - '// @input bool conversationInView = true {"hint":"While the server talks, his subtitle, the reply and the say-it strip sit together in the line of sight to his face (28 Nov). Off = the old placement (cards on the counter tray)"}'
    - '// @input float stripDistanceCm = 80 {"hint":"Distance of the conversation strip from the learner (cm)", "widget":"slider", "min":50, "max":150, "step":1}'
    - "// @input float stripBelowFaceDeg = 3.5 {\"hint\":\"How far below the server's face the top of the strip sits (deg): his face stays visible above it\", \"widget\":\"slider\", \"min\":0, \"max\":25, \"step\":0.5}"
    - '// @input float stripSpacingCm = 0.5 {"hint":"Gap between the subtitle, the reply and the say-it strip (cm)", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - "// @input float stripMaxBelowDeg = 16.5 {\"hint\":\"Lowest the strip may reach below the server's face (deg; the Specs view reaches ~18° below its centre). A stack that would go lower lets his subtitle give way to the reply\", \"widget\":\"slider\", \"min\":8, \"max\":30, \"step\":0.5}"
    - "// @input float hesitationSec = 2 {\"hint\":\"Seconds of silence after the server's question before a suggested reply appears (answering out loud first shows nothing)\", \"widget\":\"slider\", \"min\":0, \"max\":6, \"step\":0.1}"
    - '// @input float prepDistanceCm = 70 {"hint":"Distance of the phrase helper in front of the learner while preparing the sentence (cm)", "widget":"slider", "min":45, "max":120, "step":1}'
    - "// @input float prepAboveDeg = 12 {\"hint\":\"While preparing, the helper's centre follows the gaze this far above it (deg): it sits over the ingredients being pointed at and their labels, never on them (a ray must reach the label's Use this word)…\", \"widget\":\"slider\", \"min\":0, \"max\":30, \"step\":0.5}"
    - '// @input float prepLowestDeg = -30 {"hint":"…but no lower than this (deg, negative = below eye level)…", "widget":"slider", "min":-45, "max":0, "step":0.5}'
    - '// @input float prepHighestDeg = -12 {"hint":"…and no higher than this: looking up at the server it stays under his face", "widget":"slider", "min":-40, "max":0, "step":0.5}'
    - '// @input bool playPhraseOnChange = true {"hint":"Use this word, Add (+ és) and the pattern switch play the updated phrase once"}'
    - "// @input bool voiceDetection = true {\"hint\":\"Listen for the learner's voice to end a speak turn. Off = only the Said it button ends it (use for recordings)\"}"
    - '// @ui {"widget":"group_end"}'
