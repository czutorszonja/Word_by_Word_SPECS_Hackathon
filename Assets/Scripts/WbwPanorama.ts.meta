  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WbwPanorama – 360° street outside the windows</span>"}'
    - '// @input Asset.Material halfA {"hint":"Unlit material with the left half of the panorama (image columns 0–50 %)"}'
    - '// @input Asset.Material halfB {"hint":"Unlit material with the right half of the panorama (image columns 50–100 %)"}'
