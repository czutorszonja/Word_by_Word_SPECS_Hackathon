    - micAudio: !<reference.AudioTrackAsset> 00000000-0000-0000-0000-000000000000
      voiceActivityEnabled: true
      onsetDb: !<float> 12.000000
      releaseDb: !<float> 6.000000
      absMinOnsetDbfs: !<float> -55.000000
